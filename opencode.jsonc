{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-dynamic-context-pruning", "opencode-tool-search", "@mohak34/opencode-notifier@latest", "opencode-auto-resume"],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={file:.secrets/tavily.key}"
    }
  },
  "default_agent": "team/tech-lead",
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/home/allen/OpencodeImprovements": "allow",
      "/home/allen/OpencodeImprovements/**": "allow"
    },
    "bash": {
      "* /tmp*": "allow",
      "*/tmp*": "allow",
      "* /home/allen/OpencodeImprovements*": "allow",
      "*/home/allen/OpencodeImprovements*": "allow"
    },
    "tool": {
      "todowrite": "deny"
    }
  }
}

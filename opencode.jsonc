{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-dynamic-context-pruning", "opencode-tool-search", "@mohak34/opencode-notifier@latest", "opencode-auto-resume"],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=REDACTED"
    }
  },
  "default_agent": "team/tech-lead"
}

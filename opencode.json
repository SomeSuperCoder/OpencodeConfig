{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-dynamic-context-pruning",
    "opencode-tool-search",
    "@mohak34/opencode-notifier@latest",
    "opencode-auto-resume",
    "@bdliyq/opencode-rate-limit-retry"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "agentmemory-mcp"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={file:.secrets/tavily.key}"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:.secrets/context7.key}"
      }
    }
  },
  "default_agent": "team/tech-lead",
  "permission": {
    "external_directory": {
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "* /tmp*": "allow",
      "*/tmp*": "allow"
    }
  }
}
